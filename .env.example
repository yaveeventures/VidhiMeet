ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://lexconnect:change-me@db:5432/lexconnect
REDIS_URL=redis://redis:6379/0
JWT_SECRET=replace-with-at-least-32-random-characters-generate-with-secrets-token-hex-32
JWT_ISSUER=vidhimeet
GOOGLE_CLIENT_ID=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=14
ALLOWED_ORIGINS=https://vidhimeet.in,https://www.vidhimeet.in,https://lawyer.vidhimeet.in,https://admin.vidhimeet.in,http://localhost:8000
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=no-reply@vidhimeet.in
SMTP_PASSWORD=your-smtp-password
SMTP_FROM_EMAIL=no-reply@vidhimeet.in
PLATFORM_FEE_PERCENT=5
VIDEO_PROVIDER=daily
DAILY_API_KEY=
DAILY_DOMAIN=lexconnect
AWS_REGION=ap-south-1
DOCUMENT_BUCKET=vidhimeet-documents
# Cloudflare R2 Endpoint (Leave empty if using AWS S3)
S3_ENDPOINT_URL=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# Cloudflare R2 / AWS S3 Credentials
AWS_ACCESS_KEY_ID=your-r2-access-key-id
AWS_SECRET_ACCESS_KEY=your-r2-secret-access-key
MAX_DOCUMENT_BYTES=10485760
DATA_ENCRYPTION_KEY=replace-with-valid-fernet-encryption-key
TRUST_PROXY=true

# Cashfree Payment Gateway
CASHFREE_APP_ID=
CASHFREE_SECRET_KEY=
CASHFREE_API_VERSION=2026-01-01
CASHFREE_MODE=sandbox
CASHFREE_PAYOUT_APP_ID=
CASHFREE_PAYOUT_SECRET_KEY=

